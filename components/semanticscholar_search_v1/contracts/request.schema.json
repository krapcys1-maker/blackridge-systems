{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blackridge://contracts/semanticscholar-search-request/v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "operation", "query"],
      "properties": {
        "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "operation": {"const": "search"},
        "query": {"type": "string", "minLength": 1, "maxLength": 500},
        "page_size": {"type": "integer", "minimum": 1, "maximum": 100, "default": 20},
        "max_results": {"type": "integer", "minimum": 1, "maximum": 1000}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "operation", "paper_id"],
      "properties": {
        "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "operation": {"const": "get-paper"},
        "paper_id": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blackridge.systems/contracts/scientific-candidate-set-v1.schema.json",
  "title": "scientific-candidate-set/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "claim", "candidates"],
  "properties": {
    "schema_version": {"const": "1"},
    "request_id": {"type": "string", "minLength": 1},
    "claim": {"type": "string", "minLength": 10},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document_id", "title", "abstract", "retrieval_score", "sentence_candidates"],
        "properties": {
          "document_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "abstract": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "retrieval_score": {"type": "number", "minimum": 0},
          "sentence_candidates": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sentence_index", "quote", "score"],
              "properties": {
                "sentence_index": {"type": "integer", "minimum": 0},
                "quote": {"type": "string", "minLength": 1},
                "score": {"type": "number", "minimum": 0, "maximum": 1}
              }
            }
          }
        }
      }
    }
  }
}

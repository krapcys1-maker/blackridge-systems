{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query",
    "paper",
    "trace",
    "document"
  ],
  "properties": {
    "query": {
      "type": "object"
    },
    "paper": {
      "type": "object"
    },
    "trace": {
      "type": "object"
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

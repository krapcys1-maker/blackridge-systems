{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report",
    "trace"
  ],
  "properties": {
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "based_on"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "based_on": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "sink"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "sink": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

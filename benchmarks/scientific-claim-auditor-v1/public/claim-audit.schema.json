{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blackridge.systems/contracts/scientific-claim-audit-v1.schema.json",
  "title": "scientific-claim-audit/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "claim", "status", "summary", "documents", "sources"],
  "properties": {
    "schema_version": {"const": "1"},
    "request_id": {"type": "string", "minLength": 1},
    "claim": {"type": "string", "minLength": 10},
    "status": {
      "enum": ["supported", "contradicted", "mixed", "insufficient-evidence"]
    },
    "summary": {"type": "string", "minLength": 1, "maxLength": 3000},
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document_id", "title", "verdict", "rationales"],
        "properties": {
          "document_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "verdict": {"enum": ["support", "contradict"]},
          "rationales": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sentence_index", "quote"],
              "properties": {
                "sentence_index": {"type": "integer", "minimum": 0},
                "quote": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document_id", "title"],
        "properties": {
          "document_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "insufficient-evidence"}}},
      "then": {
        "properties": {
          "documents": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "supported"}}},
      "then": {
        "properties": {
          "documents": {
            "minItems": 1,
            "items": {"properties": {"verdict": {"const": "support"}}}
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "contradicted"}}},
      "then": {
        "properties": {
          "documents": {
            "minItems": 1,
            "items": {"properties": {"verdict": {"const": "contradict"}}}
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "mixed"}}},
      "then": {
        "properties": {
          "documents": {
            "minItems": 2,
            "allOf": [
              {"contains": {"properties": {"verdict": {"const": "support"}}}},
              {"contains": {"properties": {"verdict": {"const": "contradict"}}}}
            ]
          }
        }
      }
    }
  ]
}

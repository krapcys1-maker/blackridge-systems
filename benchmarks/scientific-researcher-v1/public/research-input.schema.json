{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blackridge.systems/contracts/research-input-v1.schema.json",
  "title": "research-request/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "question", "minimum_sources", "documents"],
  "properties": {
    "schema_version": {"const": "1"},
    "request_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "question": {"type": "string", "minLength": 10},
    "minimum_sources": {"type": "integer", "minimum": 1},
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document_id", "title", "full_text"],
        "properties": {
          "document_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {"type": "string", "minLength": 3},
          "full_text": {"type": "string", "minLength": 20}
        }
      }
    }
  }
}

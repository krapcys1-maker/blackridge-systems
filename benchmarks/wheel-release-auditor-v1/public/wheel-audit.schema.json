{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "wheel-audit/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "status", "summary", "artifact", "checks", "dependency_names", "license_files", "release_ready", "release_blockers"],
  "properties": {
    "schema_version": {"const": "1"},
    "request_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["policy-passed", "policy-failed"]},
    "summary": {"type": "string", "minLength": 1},
    "artifact": {"type": "object", "required": ["filename", "sha256", "size"]},
    "checks": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "passed", "expected", "observed"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "passed": {"type": "boolean"},
          "expected": {},
          "observed": {}
        }
      }
    },
    "dependency_names": {"type": "array", "items": {"type": "string"}},
    "license_files": {"type": "array", "items": {"type": "object"}},
    "release_ready": {"const": false},
    "release_blockers": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
